# Copy this file to .env and fill in real values. NEVER commit .env.

# Team identifier used in MQTT topic prefix m2i2a/equipeXX/
TEAM_ID=XX

# --- Mosquitto users (generated into mosquitto/config/passwd by fog/setup_auth.sh) ---
EDGE_USER=edge_XX
EDGE_PASSWORD=change_me_edge
FOG_USER=fog_XX
FOG_PASSWORD=change_me_fog
ADMIN_USER=admin_XX
ADMIN_PASSWORD=change_me_admin

# --- Broker / services ---
MQTT_HOST=localhost
MQTT_PORT=1883
CLOUD_URL=http://localhost:8000
FOG_HEALTH_PORT=8081

# --- Public broker (Wokwi demo, option A) ---
PUBLIC_MQTT_HOST=broker.emqx.io
PUBLIC_MQTT_PORT=1883

# --- SQLite ---
FOG_DB=fog_data.db
CLOUD_DB=cloud.db

# --- Model / drift ---
DRIFT_PSI_THRESHOLD=0.2
RETRAIN_ACC_DROP_POINTS=3.0
